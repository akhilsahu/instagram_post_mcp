# ==============================================================================
# Instagram MCP Server Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Instagram Meta Graph API Credentials (REQUIRED)
# ------------------------------------------------------------------------------
# A Meta User or Page Access Token with the following permissions:
# - instagram_content_publish
# - instagram_basic
# - pages_show_list
# - pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here

# (Optional) Your Instagram Business or Creator Account ID.
# If left blank, the server automatically queries /me/accounts and auto-discovers
# the connected Instagram account linked to your Facebook Page!
INSTAGRAM_ACCOUNT_ID=

# Meta Graph API version (default is v21.0)
GRAPH_API_VERSION=v21.0


# ------------------------------------------------------------------------------
# 2. Image Hosting Options (For hosting local AI-generated images)
# ------------------------------------------------------------------------------
# Instagram's Graph API requires a public HTTPS URL to ingest media.
# When the AI agent provides a local image file path or base64 data, the MCP server
# automatically uploads it to get a temporary public URL.
#
# Choose ONE of the following:
#
# Option A: ImgBB (Free, instant API key at https://api.imgbb.com/)
IMGBB_API_KEY=

# Option B: Cloudinary (Free tier: 25GB storage at https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option C: Zero-Config Fallback
# If neither ImgBB nor Cloudinary is set, the MCP server automatically uses
# a temporary public upload service (tmpfiles.org) without requiring any API keys!


# ------------------------------------------------------------------------------
# 3. Formatting & Behavior
# ------------------------------------------------------------------------------
# Automatically format images to comply with Instagram requirements
# (aspect ratio between 4:5 and 1.91:1, RGB JPEG format, < 8MB)
AUTO_FORMAT_IMAGES=true

# Temporary working directory for image processing
INSTA_TEMP_DIR=/tmp/insta_mcp
